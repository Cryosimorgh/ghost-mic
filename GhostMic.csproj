<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.0</Version>
    <ApplicationIcon>assets\ghost-mic.ico</ApplicationIcon>
    <Product>Ghost Mic</Product>
    <Description>Local microphone gain, live monitoring, and virtual microphone routing for Windows.</Description>
    <RepositoryUrl>https://github.com/Cryosimorgh/ghost-mic</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
